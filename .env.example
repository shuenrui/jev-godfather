# General LLM for advice generation (OpenAI-compatible chat completions).
# Leave LLM_API_KEY empty to run the interface in demo mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: TypeSafe/Jev fit evaluation. When present, Jev overrides the
# fit label with a typed decision and the response is marked "Jev evaluated".
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
