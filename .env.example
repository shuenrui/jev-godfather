# Server defaults. Any key entered by a user in the UI's "Keys" panel is
# stored in their browser only and overrides these values per request.
#
# General LLM for advice generation (OpenAI-compatible chat completions).
# Leave LLM_API_KEY empty to run the interface in demo mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: TypeSafe/Jev screening. When present, Jev screens the local seed
# boundary FIRST and the LLM is only allowed to explain around that verdict —
# never reverse it. Without it the flow degrades to LLM-only advice.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
